rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /hiking_players/{docId} {
      allow read, create, update, delete: if request.auth != null;
    }
    match /hiking_activities/{docId} {
      allow read, create, update, delete: if request.auth != null;
    }
    match /hiking_rooms/{docId} {
      allow read, create, update, delete: if request.auth != null;
    }
  }
}
